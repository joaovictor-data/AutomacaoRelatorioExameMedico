    {
      "cell_type": "code",
      "source": [
        "# ================================\n",
        "# IMPORTAÇÃO DAS BIBLIOTECAS\n",
        "# ================================\n",
        "\n",
        "import pandas as pd  # Para leitura, manipulação e filtragem da planilha Excel\n",
        "import smtplib  # Permite enviar e-mails via protocolo SMTP\n",
        "import os  # Manipulação de arquivos e caminhos do sistema\n",
        "from datetime import datetime  # Usado para obter a data atual do sistema\n",
        "from reportlab.lib import colors  # Define cores usadas na formatação do PDF\n",
        "from reportlab.lib.pagesizes import A4, landscape  # Define o tamanho da página e a orientação (landscape)\n",
        "\n",
        "from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer\n",
        "# Estrutura a base do PDF, cria tabelas, estiliza tabelas,\n",
        "# cria textos formatados e cria espaço vertical entre os elementos, respectivamente\n",
        "\n",
        "from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle\n",
        "# Obtém estilos prontos de texto e cria estilos personalizados, respectivamente\n",
        "\n",
        "from email.mime.multipart import MIMEMultipart  # Permite montar e-mails com múltiplas partes (texto + anexo)\n",
        "from email.mime.text import MIMEText  # Permite montar e-mails com múltiplas partes (texto + anexo)\n",
        "from email.mime.base import MIMEBase  # MIMEBase: base para anexos\n",
        "from email import encoders  # Encoders: codifica anexos em Base64 para envio\n"
      ],
      "metadata": {
        "id": "10miOcuz7zCA"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ================================\n",
        "# FUNÇÃO RESPONSÁVEL PELO ENVIO DE E-MAIL\n",
        "# ================================\n",
        "\n",
        "def enviar_email(arquivo_anexo):\n",
        "    # --- DADOS DO E-MAIL (Preencha aqui) ---\n",
        "    remetente = \"seu.email@gmail.com\"  # Quem está enviando\n",
        "    senha_app = \"sua senha, se estiver ativada a verificação de 2 etapas, criar senha de app\"  # Senha do seu e-mail\n",
        "    destinatario = \"O e-mail de quem vai receber\"  # Quem vai receber a mensagem\n",
        "    # --------------------------------------\n",
        "\n",
        "    if \"seu.email\" in remetente:  # Verifica se o usuário esqueceu de trocar o e-mail\n",
        "        print(\"OBS: Configure seu e-mail e senha no código para o envio funcionar.\")\n",
        "        return\n",
        "\n",
        "    ## Criação do objeto de e-mail (texto + anexo)\n",
        "    msg = MIMEMultipart()\n",
        "\n",
        "    # Define remetente, destinatário e assunto\n",
        "    msg['From'] = remetente\n",
        "    msg['To'] = destinatario\n",
        "    msg['Subject'] = \"Relatório Automático: Exames Vencidos\"\n",
        "\n",
        "    # Corpo do e-mail\n",
        "    msg.attach(MIMEText(\"Segue relatório atualizado em anexo.\", 'plain'))\n",
        "\n",
        "    # Abre o arquivo PDF em modo binário\n",
        "    with open(arquivo_anexo, \"rb\") as f:\n",
        "        part = MIMEBase('application', 'octet-stream')\n",
        "        # Lê o conteúdo do arquivo\n",
        "        part.set_payload(f.read())\n",
        "\n",
        "        # Codifica o arquivo para Base64\n",
        "        encoders.encode_base64(part)\n",
        "        part.add_header('Content-Disposition', f'attachment; filename={arquivo_anexo}')\n",
        "        msg.attach(part)\n",
        "\n",
        "    try:\n",
        "        # Conexão com o servidor SMTP do Gmail\n",
        "        # Configuração para GMAIL. Para Outlook, troque para smtp.office365.com\n",
        "        server = smtplib.SMTP('smtp.gmail.com', 587)\n",
        "\n",
        "        # Inicia conexão segura (TLS)\n",
        "        server.starttls()\n",
        "\n",
        "        # Autenticação no servidor\n",
        "        server.login(remetente, senha_app)\n",
        "\n",
        "        # Envia o e-mail\n",
        "        server.send_message(msg)\n",
        "\n",
        "        # Encerra a conexão\n",
        "        server.quit()\n",
        "\n",
        "        print(f\"-> E-mail enviado para {destinatario}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        # Tratamento de erro no envio\n",
        "        print(f\"-> Erro no envio de e-mail: {e}\")\n",
        "\n",
        "# ================================\n",
        "# FUNÇÃO PRINCIPAL DA AUTOMAÇÃO\n",
        "# ================================\n",
        "# Lê a planilha, filtra exames vencidos, gera PDF e envia por e-mail\n",
        "\n",
        "def automacao_completa():\n",
        "\n",
        "    arquivo_entrada = 'nome_do_seu_arquivo.xlsx'  # SUBSTITUA pelo nome do seu arquivo\n",
        "    arquivo_saida = 'Relatorio_Vencidos.pdf'  # SUBSTITUA pelo nome desejado da saída\n",
        "    hoje = pd.to_datetime(datetime.now().date())  # Data atual convertida para o formato datetime do pandas\n",
        "\n",
        "    print(\"1. Analisando planilha...\")\n",
        "    try:\n",
        "        df = pd.read_excel(arquivo_entrada, sheet_name='Sua aba da planilha específica')  # Substitua pela aba específica da planilha\n",
        "    except:\n",
        "        print(\"Erro ao ler arquivo Excel.\")\n",
        "        return\n",
        "\n",
        "    # ================================\n",
        "    # TRATAMENTO E FILTRO DE DATAS\n",
        "    # ================================\n",
        "\n",
        "    # Converte a coluna de data para datetime\n",
        "    # errors='coerce' transforma valores inválidos em NaT\n",
        "    df['Data Vencimento'] = pd.to_datetime(df['Data Vencimento'], errors='coerce')\n",
        "    filtro = df['Data Vencimento'] <= hoje  # Cria um filtro para datas vencidas (menores ou iguais a hoje)\n",
        "    df_vencidos = df[filtro & df['Data Vencimento'].notna()]  # Aplica o filtro e remove valores nulos\n",
        "\n",
        "    # Se não houver registros vencidos, encerra o processo\n",
        "    if df_vencidos.empty:\n",
        "        print(\"Nenhum exame vencido. E-mail não será enviado.\")\n",
        "        return\n",
        "\n",
        "    print(f\"2. Gerando PDF com {len(df_vencidos)} registros...\")\n",
        "\n",
        "    # ================================\n",
        "    # GERAÇÃO DO PDF\n",
        "    # ================================\n",
        "\n",
        "    dados = df_vencidos[['Nome Profissional', 'Aci', 'Data Vencimento']].copy()  # Colunas da planilha para o relatório\n",
        "    dados['Data Vencimento'] = dados['Data Vencimento'].dt.strftime('%d/%m/%Y')  # Formata a data para o padrão brasileiro\n",
        "    lista_dados = [dados.columns.to_list()] + dados.values.tolist()  # Converte os dados para lista (exigido pelo ReportLab)\n",
        "\n",
        "    # Cria o documento PDF em modo paisagem\n",
        "    pdf = SimpleDocTemplate(arquivo_saida, pagesize=landscape(A4))\n",
        "    elementos = []  # Lista de elementos que compõem o PDF\n",
        "    estilos = getSampleStyleSheet()  # Estilos padrão de texto\n",
        "\n",
        "    # Título do relatório\n",
        "    elementos.append(Paragraph(f\"RELATÓRIO EXAMES VENCIDOS - {hoje.strftime('%d/%m/%Y')}\", estilos['Title']))\n",
        "    elementos.append(Spacer(1, 20))  # Espaçamento vertical\n",
        "\n",
        "    # Criação da tabela\n",
        "    tabela = Table(lista_dados)\n",
        "    tabela.setStyle(TableStyle([\n",
        "        ('BACKGROUND', (0, 0), (-1, 0), colors.darkred),\n",
        "        ('TEXTCOLOR', (0, 0), (-1, 0), colors.white),\n",
        "        ('GRID', (0, 0), (-1, -1), 1, colors.black)\n",
        "    ]))\n",
        "    elementos.append(tabela)\n",
        "\n",
        "    # ================================\n",
        "    # TOTALIZADOR DE EXAMES VENCIDOS\n",
        "    # ================================\n",
        "\n",
        "    estilo_total = ParagraphStyle('Total', parent=estilos['Normal'], textColor=colors.red, spaceBefore=20)\n",
        "    elementos.append(Paragraph(f\"<b>TOTAL: {len(df_vencidos)}</b>\", estilo_total))\n",
        "\n",
        "    # Gera o PDF final\n",
        "    pdf.build(elementos)\n",
        "\n",
        "    # ================================\n",
        "    # ENVIO DO E-MAIL\n",
        "    # ================================\n",
        "\n",
        "    print(\"3. Enviando por e-mail...\")\n",
        "    enviar_email(arquivo_saida)\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    automacao_completa()\n"
      ],
      "metadata": {
